# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# ── Datasets (downloaded manually, can be large / credentialed) ──
data/raw/**
!data/raw/.gitkeep
# keep small synthetic demo images that ship with the repo
!data/sample/**
# generated manifests contain machine-specific absolute paths
data/manifests/

# ── Raw dataset folders placed in the project root (large; not for git) ──
dataset anemia/
CP-AnemiC*/
Palm/

# ── Model artifacts ──
ml/checkpoints/*.pt
ml/checkpoints/*.pth
ml/checkpoints/*.onnx
!ml/checkpoints/.gitkeep

# ── Outputs ──
outputs/
*.csv
!tests/**/*.csv

# ── OS / editor / large media ──
.DS_Store
.idea/
.vscode/
*.log
*.mov
